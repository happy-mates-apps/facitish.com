# ~/gaer/app.env on the server — the app's settings. Never commit the real file.
# Database URLs, GAER_ENV and TRUST_PROXY are set by compose.yml.

DOMAIN=facitish.com
ORIGIN=https://facitish.com
RP_ID=facitish.com
RP_NAME=Facitish
# openssl rand -hex 32
SECRET_KEY=

# Recommended in production: the only phone number that may become the first admin.
BOOTSTRAP_ADMIN_PHONE=+4512345678

# Login codes by e-mail via Lettermint (Project API token; facitish.com verified in Lettermint)
MAIL_PROVIDER=lettermint
MAIL_FROM=login@facitish.com
MAIL_FROM_NAME=Facitish
LETTERMINT_API_TOKEN=

# OVHcloud SMS (login does not work in production without it)
SMS_PROVIDER=ovh
SMS_SENDER=Facitish
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=sms-xx00000-1

# UpCloud Managed Object Storage (S3-compatible)
STORAGE_BACKEND=s3
S3_ENDPOINT=https://xxxxx.upcloudobjects.com
S3_REGION=europe-4
S3_BUCKET=gaer-facitish
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional AI chat. Leave AI_API_KEY empty to keep the chat off.
AI_API_KEY=
AI_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
AI_MODEL=Meta-Llama-3_3-70B-Instruct
