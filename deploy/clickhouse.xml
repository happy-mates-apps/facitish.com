<?xml version="1.0"?>
<!-- Gær's ClickHouse settings, mounted as /etc/clickhouse-server/config.d/gaer.xml (deploy/compose.yml and the local
     docker-compose.yml). Merged into the image's config.xml: only what is named here changes. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <!-- A small server shared with Postgres, the app and NATS: cap ClickHouse at 1.5 GiB and keep caches small.
         Raise max_server_memory_usage on a bigger server; /admin/resources shows use against this limit. -->
    <max_server_memory_usage>1610612736</max_server_memory_usage>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <concurrent_threads_soft_limit_num>2</concurrent_threads_soft_limit_num>

    <!-- 7 days retention for ClickHouse's own logs too (the gaer tables have it in their schema). -->
    <query_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_log>
    <query_thread_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_thread_log>
    <query_views_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></query_views_log>
    <part_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></part_log>
    <trace_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></trace_log>
    <metric_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></metric_log>
    <asynchronous_metric_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></asynchronous_metric_log>
    <text_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></text_log>
    <processors_profile_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></processors_profile_log>
    <error_log><ttl>event_date + INTERVAL 7 DAY DELETE</ttl></error_log>
</clickhouse>
