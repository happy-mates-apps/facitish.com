# ~/gaer/.env on the instance. Created by Happy Mates when the instance is provisioned.
# Never commit the real file.

GAER_ENV=production
DOMAIN=app.kunde.dk
ORIGIN=https://app.kunde.dk
RP_ID=app.kunde.dk
RP_NAME=Kunde
# openssl rand -hex 32
SECRET_KEY=

# Own database in the shared managed PostgreSQL cluster (see deploy/provision_database.py)
DATABASE_URL=postgresql://gaer_kunde_app:...@postgresql-xxxx.database.cloud.ovh.net:20184/gaer_kunde?sslmode=require
PURGE_DATABASE_URL=postgresql://gaer_kunde_purge:...@postgresql-xxxx.database.cloud.ovh.net:20184/gaer_kunde?sslmode=require
MIGRATION_DATABASE_URL=postgresql://gaer_kunde_owner:...@postgresql-xxxx.database.cloud.ovh.net:20184/gaer_kunde?sslmode=require

# OVHcloud SMS
SMS_PROVIDER=ovh
SMS_SENDER=Kunde
OVH_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE=sms-xx00000-1

# OVHcloud Object Storage (S3-compatible)
STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=gaer-kunde
S3_ACCESS_KEY=
S3_SECRET_KEY=
